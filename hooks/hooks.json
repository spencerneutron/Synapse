{
  "description": "Synapse: always-on rules, an extraction reminder, the project's Facts, and team sync at session start; recall hints on prompts; a dispatch reminder after a run of hands-on tool calls, and above a context threshold a one-time deny of the next one; emission-contract check and a one-time checkpoint ask at stop; summary guidance at compaction; the session's working files archived at session end",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\" core",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\" platform",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" pending --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" facts --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" shared hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" nudge --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" gate --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" nudge --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" nudge --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_MIN_PY=3.9 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/emission_check.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" gate --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" compact-guide --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" archive --auto --hook",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" recall-hint",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "SYNAPSE_OPTIONAL=1 bash \"${CLAUDE_PLUGIN_ROOT}/lib/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/lib/synapse/cli.py\" nudge --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
